{
  "id": "storeOpsDailyReport01",
  "versionId": "8e3f4051-6c7d-4e8f-a091-b2c3d4e5f607",
  "name": "Store Ops - Báo cáo cuối ngày",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 22 * * *"
            }
          ]
        }
      },
      "name": "Mỗi ngày lúc 22h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "id": "2b5c9e32-7d30-4c74-9f80-3c4d5e6f7001"
    },
    {
      "parameters": {
        "jsCode": "// ===== CẤU HÌNH: sửa ba giá trị này =====\nreturn [{\n  json: {\n    web_app_url: 'DAN_URL_WEB_APP_VAO_DAY',\n    notify_to: 'DAN_EMAIL_NHOM_VAO_DAY',\n    from_email: 'DAN_GMAIL_GUI_VAO_DAY',\n  },\n}];"
      },
      "name": "Cấu hình",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "id": "2b5c9e32-7d30-4c74-9f80-3c4d5e6f7002"
    },
    {
      "parameters": {
        "url": "={{ $json.web_app_url }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "action",
              "value": "report"
            }
          ]
        },
        "options": {
          "timeout": 20000,
          "redirect": {
            "redirect": {
              "followRedirects": true,
              "maxRedirects": 5
            }
          },
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "name": "Lấy báo cáo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "id": "2b5c9e32-7d30-4c74-9f80-3c4d5e6f7003",
      "credentials": {
        "httpQueryAuth": {
          "id": "storeOpsWebAppKey",
          "name": "Store Ops - khoa Apps Script"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Apps Script tính số liệu và nội dung; ở đây chỉ gắn người nhận.\nconst data = $input.first().json;\nconst cfg = $('Cấu hình').first().json;\nif (data.ok !== true) {\n  throw new Error('Apps Script không trả báo cáo: ' + (data.error_code || 'phản hồi lạ'));\n}\nreturn [{\n  json: { subject: data.subject, text: data.text, to: cfg.notify_to, from: cfg.from_email },\n}];"
      },
      "name": "Soạn email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "id": "2b5c9e32-7d30-4c74-9f80-3c4d5e6f7004"
    },
    {
      "parameters": {
        "fromEmail": "={{ $json.from }}",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.text }}",
        "options": {
          "appendAttribution": false
        }
      },
      "name": "Gửi email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        880,
        0
      ],
      "id": "2b5c9e32-7d30-4c74-9f80-3c4d5e6f7005",
      "credentials": {
        "smtp": {
          "id": "storeOpsGmailSmtp",
          "name": "Store Ops - Gmail SMTP"
        }
      }
    }
  ],
  "connections": {
    "Mỗi ngày lúc 22h": {
      "main": [
        [
          {
            "node": "Cấu hình",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Cấu hình": {
      "main": [
        [
          {
            "node": "Lấy báo cáo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Lấy báo cáo": {
      "main": [
        [
          {
            "node": "Soạn email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Soạn email": {
      "main": [
        [
          {
            "node": "Gửi email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Ho_Chi_Minh",
    "saveDataSuccessExecution": "none"
  },
  "active": false
}
